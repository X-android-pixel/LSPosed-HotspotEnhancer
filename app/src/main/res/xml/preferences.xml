<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="connected_clients_category"
        android:title="Connected Devices">
        <Preference
            android:summary="No devices connected"
            android:title="Loading..." />
    </PreferenceCategory>

    <PreferenceCategory android:title="Hotspot Configuration">
        <SeekBarPreference
            android:defaultValue="10"
            android:key="max_clients"
            android:max="32"
            android:title="@string/pref_max_clients_title"
            android:summary="@string/pref_max_clients_summary" />

        <EditTextPreference
            android:key="hotspot_ssid"
            android:title="SSID"
            android:summary="Change Hotspot name" />

        <EditTextPreference
            android:key="hotspot_password"
            android:title="Password"
            android:summary="Change Hotspot password" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Automation">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="auto_off_enabled"
            android:title="@string/pref_auto_off_title"
            android:summary="@string/pref_auto_off_summary" />

        <ListPreference
            android:defaultValue="600"
            android:entries="@array/auto_off_entries"
            android:entryValues="@array/auto_off_values"
            android:key="auto_off_timeout"
            android:title="Timeout Delay"
            android:dependency="auto_off_enabled" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Blocking">
        <Preference
            android:key="manage_blacklist"
            android:title="Manage Blacklist"
            android:summary="Block specific MAC addresses" />
    </PreferenceCategory>

</PreferenceScreen>
